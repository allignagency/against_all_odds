<div
  id="{{ uid }}"
  class="aao-ss-block aao-ss-tabs"
  data-tab-layout="{{ tab_layout }}"
  style="--tab-count:{{ rendered_keys.size }};--padding-top:{{ s.padding_vertical | default: 0 }}px;--padding-bottom:{{ s.padding_vertical | default: 0 }}px;--padding-left:{{ s.padding_horizontal | default: 0 }}px;--padding-right:{{ s.padding_horizontal | default: 0 }}px;--radius:{{ radius }}px;--tab-radius:{{ tab_radius }}px;--box-shadow:{{ box_shadow }};--active-tab-background:{{ light_color }};--active-tab-text-color:{{ text_color }};--inactive-tab-background:{{ inactive_bg }};--inactive-tab-text-color:{{ tab_text_color }};--panel-background:{{ light_color }};--text-color:{{ text_color }};--muted-text-color:{{ s.muted_text_color | default: '#6b6b6b' }};--active-underline-color:{{ text_color }};--verified-badge-color:{{ verified_color }};--verified-badge-background:{{ verified_bg }};--tab-text-size-desktop:{{ tab_text_size }}px;--tab-text-size-mobile:{{ tab_text_size_m }}px;--tab-font-weight:{{ s.tab_font_weight | default: 700 }};--content-text-size-desktop:{{ content_size }}px;--content-text-size-mobile:{{ content_size_m }}px;--star-size-desktop:{{ star_size }}px;--star-size-mobile:{{ star_size_m }}px;--reviewer-name-size-desktop:{{ content_size }}px;--reviewer-name-size-mobile:{{ content_size_m }}px;--reviewer-meta-size-desktop:{{ meta_size }}px;--reviewer-meta-size-mobile:{{ meta_size_m }}px;--stars-color:{{ s.stars_color | default: '#111111' }};--divider-color:{{ divider_color }};--panel-divider-color:{{ s.border_color | default: '#E5E7EB' }};{{ border_vars }}"
>
  <div class="aao-tabs__shell">
    <div class="aao-tabs__list" role="tablist" aria-label="Product tabs">
      {%- for key in rendered_keys -%}
        {%- liquid
          assign title_key = key | append: '_title'
          assign tab_title = s[title_key]
          if tab_title == blank
            assign tab_title = 'Tab ' | append: forloop.index
          endif
          assign is_active = false
          if key == default_tab
            assign is_active = true
          endif
        -%}
        <button
          type="button"
          class="aao-tabs__button{% if is_active %} is-active{% endif %}"
          id="{{ uid }}-tab-{{ key }}"
          data-tab-key="{{ key }}"
          role="tab"
          aria-controls="{{ uid }}-panel-{{ key }}"
          aria-selected="{{ is_active }}"
          tabindex="{% if is_active %}0{% else %}-1{% endif %}"
        >{{ tab_title }}</button>
      {%- endfor -%}
    </div>

    {%- for key in rendered_keys -%}
      {%- liquid
        assign text_key = key | append: '_text'
        assign tab_content = s[text_key]
        if key == description_tab
          assign tab_content = product.description
        endif

        assign is_review = false
        if key == review_tab
          assign is_review = true
        endif

        assign show_payment = false
        if payment_target == 'all' or payment_target == key
          assign show_payment = true
        endif

        assign is_active = false
        if key == default_tab
          assign is_active = true
        endif
      -%}
      <div
        class="aao-tabs__panel"
        id="{{ uid }}-panel-{{ key }}"
        role="tabpanel"
        aria-labelledby="{{ uid }}-tab-{{ key }}"
        data-tab-key="{{ key }}"
        {% unless is_active %}hidden{% endunless %}
      >
        <div class="aao-tabs__stack">
          {%- if is_review -%}{{ stars_markup }}{%- endif -%}
          {%- if tab_content != blank -%}<div class="aao-tabs__content">{{ tab_content }}</div>{%- endif -%}
          {%- if is_review -%}{{ reviewer_markup }}{%- endif -%}
          {%- if show_payment and payment_icons_html != blank -%}
            <div class="aao-tabs__payment-section">{{ payment_icons_html }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById({{ uid | json }});
    if (!root) return;

    var list = root.querySelector('.aao-tabs__list');
    var buttons = Array.prototype.slice.call(root.querySelectorAll('.aao-tabs__button'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('.aao-tabs__panel'));
    var isUnderline = root.dataset.tabLayout === 'underline';

    function syncUnderline() {
      if (!isUnderline || !list) return;
      var active = buttons.filter(function (b) { return b.classList.contains('is-active'); })[0];
      if (!active) {
        list.style.setProperty('--underline-left', '0px');
        list.style.setProperty('--underline-width', '0px');
        list.dataset.underlineVisible = 'false';
        return;
      }
      var listRect = list.getBoundingClientRect();
      var rect = active.getBoundingClientRect();
      list.style.setProperty('--underline-left', Math.max(0, rect.left - listRect.left) + 'px');
      list.style.setProperty('--underline-width', Math.max(0, rect.width) + 'px');
      list.dataset.underlineVisible = rect.width > 0 ? 'true' : 'false';
    }

    function activate(key) {
      buttons.forEach(function (b) {
        var on = b.dataset.tabKey === key;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (p) { p.hidden = p.dataset.tabKey !== key; });
      syncUnderline();
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () { activate(b.dataset.tabKey); });
    });

    if (isUnderline && list) {
      list.dataset.underlineReady = 'false';
      list.dataset.underlineVisible = 'false';
      syncUnderline();
      requestAnimationFrame(function () { list.dataset.underlineReady = 'true'; });
      window.addEventListener('resize', syncUnderline);
      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(syncUnderline);
        ro.observe(list);
        buttons.forEach(function (b) { ro.observe(b); });
      }
    }
  })();
</script>
