{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
AAO BENEFITS LIST
----------------------------------------------------------------------------------------------------------------------

Native replacement for the Section Store app block
"shopify://apps/section-store/blocks/block-benefits-list/...".

Markup, CSS and the CSS-variable computation are transcribed from the app's own client bundle
(cdn.shopify.com/extensions/.../section-factory-352/assets/block-benefits-list.js) so the block keeps
rendering identically once the Section Store subscription is cancelled. The app rendered into a shadow
root; here the styles are scoped to the block id instead.

********************************************
Supported variables
********************************************

* block: the section block holding the settings
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign uid = 'aao-b-' | append: block.id

  assign align = s.content_align | default: 'left'
  case align
    when 'center'
      assign h_align = 'center'
    when 'right'
      assign h_align = 'end'
    else
      assign h_align = 'start'
  endcase

  assign flex_direction = 'row'
  if h_align == 'end'
    assign flex_direction = 'row-reverse'
  endif

  assign text_size = s.text_size | default: 14
  assign icon_size = s.icon_size | default: 18
  assign text_size_m = text_size | times: 0.9 | round
  assign icon_size_m = icon_size | times: 0.9 | round

  assign background = s.background_gradient | default: s.background
  assign items_gap = s.items_gap | default: 0
  assign padding_vertical = s.padding_vertical | default: 0
  assign padding_horizontal = s.padding_horizontal | default: 0
  assign radius = s.radius | default: 0
  assign icon_selection = s.icon_selection | default: 'check_mark'

  assign border_style = s.border | default: 'none'
  if border_style == 'none'
    capture border_vars
      echo '--border-width:0px;--border-style:none;--border-color:transparent;'
    endcapture
  else
    capture border_vars
      echo '--border-width:'
      echo s.border_thickness | default: 1
      echo 'px;--border-style:'
      echo border_style
      echo ';--border-color:'
      echo s.border_color | default: '#1c1c1c'
      echo ';'
    endcapture
  endif
-%}

<style>
  #{{ uid }} {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: var(--padding-left);
    padding-right: var(--padding-right);
    border-radius: var(--border-radius);
    overflow: hidden;
    background: var(--background-color);
    border: var(--border-width) var(--border-style) var(--border-color);
  }

  #{{ uid }} .aao-bl__list {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--items-gap);
  }

  #{{ uid }} .aao-bl__item {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: var(--content-horizontal-align);
    flex-direction: var(--flex-direction);
  }

  #{{ uid }} .aao-bl__text > * {
    margin: 0;
    text-align: var(--content-align);
    font-size: var(--text-size-mobile);
    line-height: 150%;
    color: var(--text-color);
    text-transform: unset;
  }

  #{{ uid }} .aao-bl__icon {
    display: block !important;
    position: relative;
    border-radius: 50%;
    min-width: var(--icon-size-mobile);
    width: var(--icon-size-mobile);
    height: var(--icon-size-mobile);
  }

  #{{ uid }} .aao-bl__icon svg,
  #{{ uid }} .aao-bl__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ uid }} .aao-bl__icon svg path {
    fill: var(--icon-color);
  }

  #{{ uid }} .aao-bl__icon svg circle,
  #{{ uid }} .aao-bl__icon svg polyline {
    stroke: var(--icon-color);
  }

  @media (min-width: 1024px) {
    #{{ uid }} .aao-bl__text > * {
      font-size: var(--text-size-desktop);
    }

    #{{ uid }} .aao-bl__icon {
      min-width: var(--icon-size-desktop);
      width: var(--icon-size-desktop);
      height: var(--icon-size-desktop);
    }
  }
</style>

<div
  id="{{ uid }}"
  class="aao-ss-block aao-ss-benefits-list"
  style="--items-gap:{{ items_gap }}px;--padding-top:{{ padding_vertical }}px;--padding-bottom:{{ padding_vertical }}px;--padding-left:{{ padding_horizontal }}px;--padding-right:{{ padding_horizontal }}px;--border-radius:{{ radius }}px;--background-color:{{ background }};--content-horizontal-align:{{ h_align }};--content-align:{{ align }};--text-color:{{ s.text_color | default: '#1c1c1c' }};--icon-color:{{ s.icon_color | default: '#1c1c1c' }};--text-size-mobile:{{ text_size_m }}px;--text-size-desktop:{{ text_size }}px;--icon-size-mobile:{{ icon_size_m }}px;--icon-size-desktop:{{ icon_size }}px;--flex-direction:{{ flex_direction }};{{ border_vars }}"
>
  <div class="aao-bl__list">
    {%- if s.first_text != blank -%}
      <div class="aao-bl__item aao-bl__item--first">
        <div class="aao-bl__icon">{%- render 'aao-ss-icon', icon: icon_selection -%}</div>
        <div class="aao-bl__text">{{ s.first_text }}</div>
      </div>
    {%- endif -%}

    {%- if s.second_text != blank -%}
      <div class="aao-bl__item aao-bl__item--second">
        <div class="aao-bl__icon">{%- render 'aao-ss-icon', icon: icon_selection -%}</div>
        <div class="aao-bl__text">{{ s.second_text }}</div>
      </div>
    {%- endif -%}

    {%- if s.third_text != blank -%}
      <div class="aao-bl__item aao-bl__item--third">
        <div class="aao-bl__icon">{%- render 'aao-ss-icon', icon: icon_selection -%}</div>
        <div class="aao-bl__text">{{ s.third_text }}</div>
      </div>
    {%- endif -%}

    {%- if s.fourth_text != blank -%}
      <div class="aao-bl__item aao-bl__item--fourth">
        <div class="aao-bl__icon">{%- render 'aao-ss-icon', icon: icon_selection -%}</div>
        <div class="aao-bl__text">{{ s.fourth_text }}</div>
      </div>
    {%- endif -%}
  </div>
</div>
