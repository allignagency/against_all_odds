{%- comment -%}
  Product Motion. A full-bleed scroll-scrubbed product film.
  This section renders NOTHING unless the product has a video attached to its
  "Motion video" metafield (custom.motion_video). No code changes are needed
  to enable or disable it per product: attach or remove the metafield value.

  Metafields read (all under the "custom" namespace, all optional except the
  first, which gates whether anything renders at all):
    motion_video         file_reference (video)  REQUIRED to show the section
    motion_video_mobile  file_reference (video)  optional, falls back to motion_video
    motion_poster        file_reference (image)  optional poster frame
    motion_kicker        single_line_text_field  optional, small label above heading
    motion_heading       single_line_text_field  optional, falls back to product title
    motion_body          multi_line_text_field   optional, one line of body copy
    motion_track_vh      number_integer          optional, scroll length in vh (default 300)
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.custom
  assign motion_video = mf.motion_video.value
-%}

{%- if motion_video != blank -%}
  {%- liquid
    assign motion_video_mobile = mf.motion_video_mobile.value
    assign motion_poster = mf.motion_poster.value
    assign motion_kicker = mf.motion_kicker.value
    assign motion_heading = mf.motion_heading.value
    assign motion_body = mf.motion_body.value
    assign motion_track_vh = mf.motion_track_vh.value | default: 300
  -%}
  {%- render 'product-motion-scrub',
    video_url: motion_video.url,
    video_url_mobile: motion_video_mobile.url,
    poster_url: motion_poster.url,
    kicker: motion_kicker,
    heading: motion_heading,
    body: motion_body,
    track_vh: motion_track_vh
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Product Motion",
  "tag": "section",
  "class": "shopify-section--product-motion",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a full-bleed, scroll-scrubbed video on the product page. This section is invisible and takes up no space unless the product has a video attached to its Motion video metafield (Settings > Custom data > Products, or the Metafields panel on the product page). No theme edits are needed per product: attach a video to show it, remove it to hide it."
    }
  ],
  "presets": [{ "name": "Product Motion" }]
}
{% endschema %}
