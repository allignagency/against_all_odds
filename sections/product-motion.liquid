{%- comment -%}
  Product Motion: full-bleed scroll-scrubbed video.
  The section occupies a tall scroll track; the video pins to the viewport and
  its playback position follows scroll progress (scrub). Falls back to an
  autoplay loop when scrubbing is unsupported or reduced motion is requested.
  Renders only when a video source is set AND (allowlist empty OR handle listed).
{%- endcomment -%}

{%- liquid
  assign show_section = false
  assign video_src = section.settings.video_url
  if video_src == blank and section.settings.video_asset != blank
    assign video_src = section.settings.video_asset | asset_url
  endif
  assign video_src_mobile = section.settings.video_url_mobile | default: video_src
  if video_src != blank
    if section.settings.product_handles == blank
      assign show_section = true
    else
      assign allow = section.settings.product_handles | replace: ' ', '' | split: ','
      if allow contains product.handle
        assign show_section = true
      endif
    endif
  endif
-%}

{%- if show_section -%}
<div class="aao-scrub" id="aao-scrub-{{ section.id }}" style="height: {{ section.settings.track_height | default: 300 }}vh;">
  <div class="aao-scrub__pin">
    <video
      class="aao-scrub__video"
      muted
      playsinline
      preload="auto"
      {% if section.settings.poster_asset != blank %}poster="{{ section.settings.poster_asset | asset_url }}"{% endif %}
      aria-label="{{ section.settings.heading | default: product.title | escape }}"
      data-src-desktop="{{ video_src }}"
      data-src-mobile="{{ video_src_mobile }}"
    ></video>
    <div class="aao-scrub__scrim"></div>
    <div class="aao-scrub__copy">
      {%- if section.settings.subheading != blank -%}
        <p class="aao-scrub__kicker">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="aao-scrub__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="aao-scrub__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .aao-scrub { position: relative; width: 100%; background: #0d0d0d; }
  .aao-scrub__pin { position: sticky; top: 0; height: 100vh; height: 100dvh; overflow: hidden; }
  .aao-scrub__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aao-scrub__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 38%); pointer-events: none; }
  .aao-scrub__copy { position: absolute; left: max(24px, 4vw); bottom: max(28px, 5vh); color: #ffffff; max-width: 60ch; }
  .aao-scrub__kicker { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; opacity: .75; margin: 0 0 10px; }
  .aao-scrub__heading { font-size: clamp(30px, 4.5vw, 58px); line-height: 1.0; text-transform: uppercase; letter-spacing: .5px; margin: 0 0 10px; color: #ffffff; }
  .aao-scrub__text { font-size: 15px; line-height: 1.5; opacity: .85; max-width: 46ch; }
  .aao-scrub__text p { margin: 0; }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('aao-scrub-{{ section.id }}');
    if (!root) return;
    var video = root.querySelector('.aao-scrub__video');
    if (!video) return;

    var isMobile = window.matchMedia('(max-width: 749px)').matches;
    var src = isMobile ? video.getAttribute('data-src-mobile') : video.getAttribute('data-src-desktop');
    if (!src) return;
    var source = document.createElement('source');
    source.src = src; source.type = 'video/mp4';
    video.appendChild(source);
    video.load();

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function fallbackLoop() {
      video.loop = true;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { video.play().catch(function(){}); } else { video.pause(); }
          });
        }, { threshold: 0.2 });
        io.observe(root);
      } else { video.autoplay = true; video.play().catch(function(){}); }
    }

    if (reduced) { fallbackLoop(); return; }

    var duration = 0, target = 0, current = 0, raf = null, lastSet = -1;
    video.addEventListener('loadedmetadata', function () { duration = video.duration || 0; });
    video.pause();

    function progress() {
      var rect = root.getBoundingClientRect();
      var vh = window.innerHeight;
      var total = rect.height - vh;
      if (total <= 0) return 0;
      var p = -rect.top / total;
      return Math.max(0, Math.min(1, p));
    }

    function tick() {
      raf = null;
      if (duration > 0) {
        target = progress() * duration;
        current += (target - current) * 0.22;
        if (Math.abs(current - lastSet) > 0.02) {
          try { video.currentTime = current; lastSet = current; } catch (e) {}
        }
        if (Math.abs(target - current) > 0.01) { raf = requestAnimationFrame(tick); }
      }
    }
    function onScroll() { if (!raf) raf = requestAnimationFrame(tick); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // if scrubbing never engages (metadata fails), fall back after 4s
    setTimeout(function () { if (!duration) fallbackLoop(); }, 4000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Motion",
  "tag": "section",
  "class": "shopify-section--product-motion",
  "settings": [
    { "type": "paragraph", "content": "Full-bleed scroll-scrubbed video. Scrolling through the section drives the video timeline. Renders only when a video URL is set. Leave the handle allowlist empty to show on all products." },
    { "type": "text", "id": "video_url", "label": "Video URL (desktop scrub file)", "info": "Full https URL to an mp4 encoded with dense keyframes" },
    { "type": "text", "id": "video_url_mobile", "label": "Video URL (mobile, lighter file)", "info": "Optional. Falls back to the desktop file." },
    { "type": "text", "id": "video_asset", "label": "Video asset filename (fallback)", "info": "Used only if no URL set" },
    { "type": "text", "id": "poster_asset", "label": "Poster image asset filename" },
    { "type": "range", "id": "track_height", "label": "Scroll length (vh)", "min": 150, "max": 500, "step": 25, "default": 300 },
    { "type": "text", "id": "product_handles", "label": "Product handle allowlist (comma-separated)", "info": "Empty = all products" },
    { "type": "text", "id": "subheading", "label": "Kicker", "default": "In motion" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Product Motion" }]
}
{% endschema %}
