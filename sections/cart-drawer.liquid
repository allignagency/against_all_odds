{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CART DRAWER
----------------------------------------------------------------------------------------------------------------------

Native Prestige cart drawer, extended (aao- prefixed additions) to reach feature parity with the UpCart drawer that was
previously installed on the store:

* aao-rewards-bar      : progress meter + tier badge on top of the theme's free shipping bar (UpCart "rewards" module)
* aao-cart-upsells     : styling around the theme's native cross sell products (UpCart "upsells" module)
* aao-cart-summary     : subtotal + discounts rows above the checkout button (UpCart "cart summary" module)
* aao-cart-trust       : payment icons below the checkout button (UpCart "trust badges" module)
* cart-drawer__body-inner : keeps the line items at the top and pins the upsells to the bottom of the scroll area so the
  drawer stays composed with a single item in the cart.
{%- endcomment -%}

{%- liquid
  assign aao_fs_threshold = 0
  assign aao_fs_progress = 0

  if settings.cart_show_free_shipping_bar
    assign aao_fs_threshold = settings.cart_free_shipping_threshold | times: 100 | round

    if aao_fs_threshold > 0
      assign aao_fs_total = 0

      for line_item in cart.items
        if line_item.requires_shipping
          assign aao_fs_total = aao_fs_total | plus: line_item.final_line_price
        endif
      endfor

      for discount_application in cart.cart_level_discount_applications
        assign aao_fs_total = aao_fs_total | minus: discount_application.total_allocated_amount
      endfor

      if aao_fs_total < 0
        assign aao_fs_total = 0
      endif

      assign aao_fs_progress = aao_fs_total | times: 100 | divided_by: aao_fs_threshold

      if aao_fs_progress > 100
        assign aao_fs_progress = 100
      endif
    endif
  endif

  # The reward is free shipping, so it only makes sense while the cart ships something (or is still empty).

  assign aao_show_rewards = false

  if aao_fs_threshold > 0
    if cart.requires_shipping or cart.empty?
      assign aao_show_rewards = true
    endif
  endif
-%}

{%- capture aao_rewards_bar -%}
  {%- if aao_show_rewards -%}
    <aao-rewards-bar class="aao-rewards" style="--aao-rewards-progress: {{ aao_fs_progress }}%">
      {%- if cart.requires_shipping -%}
        {%- render 'free-shipping-bar' -%}
      {%- else -%}
        {%- assign aao_fs_amount = aao_fs_threshold | money -%}
        <div class="free-shipping-bar">
          <span class="text-subdued">{{ 'cart.free_shipping_bar.limit_unreached_html' | t: remaining_amount: aao_fs_amount }}</span>
        </div>
      {%- endif -%}

      <div class="aao-rewards__meter">
        <div class="aao-rewards__track"><div class="aao-rewards__fill"></div></div>

        {%- if section.settings.rewards_tier_label != blank -%}
          <span class="aao-rewards__badge" title="{{ section.settings.rewards_tier_label | escape }}">
            <svg class="aao-truck" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="1.5" y="5" width="13" height="11.5" rx="1.4" fill="currentColor"/><path d="M15.5 8.5h3.1c.4 0 .8.2 1 .5l2.6 3.4c.2.3.3.6.3.9v2.4c0 .5-.4.8-.8.8h-6.2z" fill="currentColor"/><path d="M17 10h1.4l1.9 2.6H17z" fill="#141414"/><circle cx="6.5" cy="17.4" r="2.9" fill="#141414"/><circle cx="6.5" cy="17.4" r="2" fill="currentColor"/><circle cx="6.5" cy="17.4" r=".75" fill="#141414"/><circle cx="17.8" cy="17.4" r="2.9" fill="#141414"/><circle cx="17.8" cy="17.4" r="2" fill="currentColor"/><circle cx="17.8" cy="17.4" r=".75" fill="#141414"/></svg>
          </span>
        {%- endif -%}
      </div>

      {%- if section.settings.rewards_tier_label != blank -%}
        <p class="aao-rewards__tier">{{ section.settings.rewards_tier_label }}</p>
      {%- endif -%}
    </aao-rewards-bar>
  {%- endif -%}
{%- endcapture -%}

{%- assign aao_rewards_bar = aao_rewards_bar | strip -%}

<cart-drawer id="cart-drawer" aria-label="{{ 'cart.general.title' | t | escape_once }}" class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" initial-focus="false" handle-editor-events>
  <p class="h4" slot="header">
    {{- 'cart.general.title' | t -}}
    {%- if section.settings.show_item_count_in_title and cart.item_count > 0 -%}
      <span class="aao-cart-title-count">{{ cart.item_count }}</span>
    {%- endif -%}
  </p>

  {%- if cart.empty? -%}
    <div class="aao-cart-empty v-stack gap-5">
      {{ aao_rewards_bar }}
      <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
    </div>
  {%- else -%}
    {%- liquid
      assign aao_max_upsells = section.settings.cross_sell_max_products | default: 3
      assign cross_sell_products_count = 0

      for product in section.settings.cross_sell_products
        assign items_for_product = cart | line_items_for: product

        if items_for_product.size == 0 and product.available
          assign cross_sell_products_count = cross_sell_products_count | plus: 1
        endif
      endfor

      if cross_sell_products_count > aao_max_upsells
        assign cross_sell_products_count = aao_max_upsells
      endif
    -%}

    <div class="cart-drawer__body-inner">
      <div class="cart-drawer__body-top">
        {{ aao_rewards_bar }}

        <div class="cart-drawer__items">
          {%- for line_item in cart.items -%}
            {%- render 'line-item', line_item: line_item, show_quantity_selector: true -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if cross_sell_products_count > 0 -%}
        <div class="cart-drawer__complementary-products complementary-products aao-cart-upsells">
          {%- assign carousel_id = 'complementary-products-carousel-' | append: section.id -%}

          {%- if section.settings.cross_sell_title != blank or section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
            <div class="complementary-products__header complementary-products__header--align-start">
              <p class="h6">{{ section.settings.cross_sell_title }}</p>

              {%- if section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
                <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots page-dots--narrow">
                  {%- for i in (1..cross_sell_products_count) -%}
                    <button class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                      <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                    </button>
                  {%- endfor -%}
                </carousel-navigation>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- liquid
            assign aao_rendered_upsells = 0

            capture complementary_products
              for product in section.settings.cross_sell_products
                if aao_rendered_upsells >= aao_max_upsells
                  break
                endif

                assign products_in_cart = cart.items | where: 'product_id', product.id

                if products_in_cart.size == 0 and product.available
                  assign aao_rendered_upsells = aao_rendered_upsells | plus: 1
                  render 'product-card-horizontal', product: product, show_quick_buy: true
                endif
              endfor
            endcapture
          -%}

          {%- if section.settings.cross_sell_stack_products -%}
            <div class="complementary-products__product-list">
              {{- complementary_products -}}
            </div>
          {%- else -%}
            <scroll-carousel id="{{ carousel_id }}" class="complementary-products__product-list complementary-products__product-list--carousel scroll-area bleed snap-x">
              {{- complementary_products -}}
            </scroll-carousel>
          {%- endif -%}

          {%- comment -%}
            Data + machinery behind the inline "Add to cart" on each upsell card.

            The card markup itself is the theme's `product-card-horizontal`, which we leave alone: for a
            single-variant product it already renders a working `product-form`, and for a multi-variant one it
            renders a button that opens the quick buy modal. We keep the single-variant path exactly as it is and
            replace only the modal path with an inline size picker, so the shopper never leaves the drawer.

            For every multi-variant upsell we render a hidden `product-form` here. Picking a size fills in its
            variant id and submits it, which means the add goes through the theme's own ProductForm element and
            fires the same `cart:change` / drawer refresh as any other quick add: no bespoke cart plumbing.

            `aao-upsell-data` carries the variant list per product handle (id, option value, availability) plus the
            option values already in the cart, newest last, which is what the picker uses to pre-select a size.
          {%- endcomment -%}

          {%- liquid
            assign aao_upsell_json_parts = ''
            assign aao_cart_option_values = '' | split: ','

            for line_item in cart.items
              assign aao_cart_option_values = aao_cart_option_values | concat: line_item.variant.options
            endfor
          -%}

          {%- capture aao_upsell_forms -%}
            {%- assign aao_form_count = 0 -%}

            {%- for product in section.settings.cross_sell_products -%}
              {%- if aao_form_count >= aao_max_upsells -%}
                {%- break -%}
              {%- endif -%}

              {%- assign products_in_cart = cart.items | where: 'product_id', product.id -%}

              {%- if products_in_cart.size == 0 and product.available -%}
                {%- assign aao_form_count = aao_form_count | plus: 1 -%}

                {%- capture aao_variants_json -%}
                  {%- for variant in product.variants -%}
                    {"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available }}}
                    {%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                {%- endcapture -%}

                {%- capture aao_entry -%}
                  {{ product.handle | json }}:{"variants":[{{ aao_variants_json | strip | strip_newlines }}]}
                {%- endcapture -%}

                {%- if aao_upsell_json_parts == blank -%}
                  {%- assign aao_upsell_json_parts = aao_entry | strip | strip_newlines -%}
                {%- else -%}
                  {%- assign aao_entry = aao_entry | strip | strip_newlines -%}
                  {%- assign aao_upsell_json_parts = aao_upsell_json_parts | append: ',' | append: aao_entry -%}
                {%- endif -%}

                {%- if product.variants.size > 1 -%}
                  <product-form class="aao-upsell-form" data-aao-upsell-form="{{ product.handle | escape }}" hidden>
                    {%- form 'product', product -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <input type="hidden" name="on_success" value="force_open_drawer">
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {{ aao_upsell_forms }}

          <script type="application/json" data-aao-upsell-data>
            {"cartOptionValues":{{ aao_cart_option_values | json }},"products":{ {{- aao_upsell_json_parts -}} }}
          </script>
        </div>
      {%- endif -%}
    </div>

    <div slot="footer">
      <form action="{{ routes.cart_url }}" class="cart-drawer__footer" method="POST">
        <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
        <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

        {%- if section.settings.show_cart_note or section.settings.show_shipping_text -%}
          <div class="v-stack gap-0.5 justify-items-start">
            {%- if section.settings.show_cart_note -%}
              {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
              <button class="link-faded-reverse" aria-controls="{{ cart_note_dialog_id }}">{{ 'cart.general.add_order_note' | t }}</button>

              <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
                <div class="form">
                  <cart-note class="form-control">
                    {%- assign order_note = 'cart.general.order_note' | t -%}
                    {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                    {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                  </cart-note>

                  <dialog-close-button class="contents">
                    <button type="button" class="button">{{ 'cart.general.save_note' | t }}</button>
                  </dialog-close-button>
                </div>
              </cart-note-dialog>
            {%- endif -%}

            {%- if section.settings.show_shipping_text -%}
              <p class="text-subdued">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.allow_discount_application -%}
          {%- render 'cart-discount' -%}
        {%- endif -%}

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="h-stack gap-3">
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="h-stack justify-start gap-4">
                <span class="discount-badge text-xs">
                  {%- render 'icon' with 'discount', width: 12 -%}
                  {{ discount_application.title }} (-{{ discount_application.total_allocated_amount | money }})

                  {%- if section.settings.allow_discount_application and discount_application.type != '' -%}
                    <cart-discount-remove-button discount-code="{{ discount_application.title | escape }}" class="h-stack align-center">
                      <button type="button">{%- render 'icon' with 'close', width: 8 -%}</button>
                    </cart-discount-remove-button>
                  {%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_subtotal -%}
          <div class="aao-cart-summary">
            {%- if cart.total_discount > 0 -%}
              <div class="aao-cart-summary__row aao-cart-summary__row--savings">
                <span>{{ 'cart.general.discounts' | t }}</span>
                <span>-{{ cart.total_discount | money }}</span>
              </div>
            {%- endif -%}

            <div class="aao-cart-summary__row aao-cart-summary__row--total">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
          </div>
        {%- endif -%}

        <div class="button-group">
          {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
            {%- assign view_cart = 'cart.general.view_cart' | t -%}
            {%- render 'button', href: routes.cart_url, content: view_cart, stretch: true -%}
          {%- endif -%}

          {%- if section.settings.show_checkout_button -%}
            {%- capture checkout_button -%}
              {{- 'cart.general.checkout' | t -}}

              {%- if section.settings.show_price_in_checkout_button -%}
                <span class="cart-drawer__button-price">{{- cart.total_price | money -}}</span>
              {%- endif -%}
            {%- endcapture -%}

            {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout', stretch: true -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-methods unstyled-list aao-cart-trust">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{- type | payment_type_svg_tag -}}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </form>
    </div>
  {%- endif -%}
</cart-drawer>

<style>
  /* Layout: items stay at the top, upsells hug the footer, so the drawer never shows a dead middle. */
  .cart-drawer:not(.drawer--center-body)::part(body) {
    align-content: stretch;
  }

  .cart-drawer__body-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .cart-drawer__body-inner > .cart-drawer__complementary-products {
    margin-block-start: auto;
  }

  /* Rewards / free shipping progress (UpCart rewards module) */
  .cart-drawer .aao-rewards {
    display: block;
    border-block-end: 1px solid rgb(var(--border-color));
    padding-block: 0.875rem 1rem;
    padding-inline: var(--drawer-body-padding-inline);
    margin-inline: calc(-1 * var(--drawer-body-padding-inline));
  }

  .cart-drawer .aao-rewards .free-shipping-bar {
    display: block;
    font-size: var(--text-sm);
    border-block-end-width: 0;
    margin-inline: 0;
    padding-inline: 0;
    padding-block: 0 0.625rem;
  }

  .aao-rewards__meter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .aao-rewards__track {
    position: relative;
    flex: 1 1 auto;
    height: 6px;
    border-radius: 999px;
    background-color: #e2e2e2;
    overflow: hidden;
  }

  .aao-rewards__fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--aao-rewards-progress, 0%);
    border-radius: 999px;
    background-color: rgb(var(--text-color));
    transition: width 0.3s ease;
  }

  /* The badge is the reward itself, so it has to read as a reward and not as a smudge at the end of the bar.
     It sits on the same #e2e2e2 as the unfilled track (so it belongs to the meter) and carries a near-black
     truck, which is the strongest contrast available on that grey. Once the threshold is met it flips to the
     solid black / white treatment the checkout button uses, so "unlocked" is legible at a glance. */
  /* Inverted for visibility: the light-grey badge read as a faint blob even with a dark glyph.
     Solid ink circle + white truck is unmissable at a glance and matches the drawer's CTA. */
  .aao-rewards__badge {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 100%;
    color: #ffffff;
    background-color: #141414;
    opacity: 1;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* The badge is a fixed circle, so the truck needs an explicit square box. The theme's generic
     .icon rule only sets `height: auto`, which leaves the rendered size at the mercy of whatever
     width any other stylesheet (theme or app) puts on the svg: a non-uniform width/height squashes
     the truck and spills it out of the circle. These selectors outrank the generic .icon rule. */
  .aao-rewards__badge > .icon,
  .aao-rewards__badge svg {
    display: block;
    flex: none;
    width: 22px;
    height: 22px;
  }

  /* The theme's global icon stroke is 1 unit on a 24 viewBox, so at 19px the truck drew at 0.79px and washed
     out however dark we made it. Overriding the path here (CSS beats the presentation attribute) puts it at
     ~1.5px rendered, which is what makes it read as a truck rather than a smudge. */


  /* No complete-state variant. The light-grey-with-outline treatment read as a broken or disabled control rather
     than an unlocked reward, so both states now use the one solid ink badge above; the tier label under the meter
     is what says whether free shipping is unlocked. */

  .aao-rewards__tier {
    margin-block-start: 0.5rem;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-color) / 0.5);
    text-align: end;
  }

  /* Quantity stepper. Same root cause as the badge above: some stylesheet on the page stretches bare svgs to
     the width of their box, so the theme's `width: 10` plus/minus rendered at 35x25 next to a 15px digit. Both
     axes are pinned here, and the control is sized to the drawer's own type scale instead of the theme's. */
  .cart-drawer .quantity-selector--sm {
    --quantity-selector-height: 32px;
    --quantity-selector-input-width: 28px;
  }

  .cart-drawer .quantity-selector__button > .icon,
  .cart-drawer .quantity-selector__button svg {
    display: block;
    flex: none;
    width: 14px;
    height: 14px;
  }

  /* Matched to the 14px quantity digit: 1.4 units on a 12 viewBox lands at ~1.6px, so the plus and minus carry
     the same visual weight as the number between them instead of the hairline the theme default draws. */
  .cart-drawer .quantity-selector__button svg path {
    stroke-width: 1.6;
  }

  .cart-drawer .quantity-selector__input {
    font-size: 14px;
  }

  .aao-cart-empty {
    width: 100%;
  }

  .aao-cart-empty .aao-rewards {
    text-align: center;
  }

  .aao-cart-empty .aao-rewards__tier {
    text-align: center;
  }

  .aao-cart-title-count {
    margin-inline-start: 0.5rem;
    color: rgb(var(--text-color) / 0.5);
  }

  .aao-cart-title-count::before {
    content: '\2022';
    margin-inline-end: 0.5rem;
  }

  /* Upsells (UpCart upsells module) */
  .cart-drawer .aao-cart-upsells {
    background-color: #f6f6f7;
    padding-block: 1.25rem;
    padding-inline: var(--drawer-body-padding-inline);
  }

  .cart-drawer .aao-upsell-form {
    display: none;
  }

  /* The theme renders the upsell's add control as an underlined text link at the narrow container size, which
     came out louder than the product title above it and did not read as tappable. Both container-query variants
     are pinned to one compact solid button so the card has a single, obvious action. */
  /* No `display` here on purpose: the theme swaps the two variants with `display: none` / `block` inside a
     container query on the card, so declaring one would show both at once. Height comes from padding instead. */
  .cart-drawer .aao-cart-upsells [class*='horizontal-product-card__button'] {
    width: fit-content;
    padding-block: 0.625rem;
    padding-inline: 0.875rem;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    border: 1px solid #111;
    background-color: #111;
    background-image: none;
  }

  .cart-drawer .aao-cart-upsells [class*='horizontal-product-card__button']:hover {
    opacity: 0.85;
  }

  .cart-drawer .aao-upsell-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-block-start: 0.5rem;
  }

  .cart-drawer .aao-upsell-size {
    min-width: 34px;
    min-height: 32px;
    padding-inline: 0.5rem;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: #111;
    border: 1px solid #d5d5d5;
    background-color: #fff;
    cursor: pointer;
  }

  .cart-drawer .aao-upsell-size:hover:not([disabled]) {
    border-color: #111;
  }

  .cart-drawer .aao-upsell-size:focus-visible {
    outline: 2px solid #111;
    outline-offset: 1px;
  }

  .cart-drawer .aao-upsell-size[data-preselected='true'] {
    border-color: #111;
    box-shadow: inset 0 0 0 1px #111;
    font-weight: 600;
  }

  .cart-drawer .aao-upsell-size[disabled] {
    color: #b5b5b5;
    border-color: #ececec;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* Summary (UpCart cart summary module) */
  .aao-cart-summary {
    display: grid;
    row-gap: 0.25rem;
    width: 100%;
  }

  .aao-cart-summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .aao-cart-summary__row--savings {
    font-size: 13px;
    color: #777;
  }

  .aao-cart-summary__row--total {
    font-size: 18px;
    font-weight: 600;
  }

  /* The footer was one flat 16px voice: order note, tax line and subtotal all shouted equally. The two
     supporting lines drop to a caption scale so the subtotal and the checkout button own the hierarchy. */
  .cart-drawer__footer .link-faded-reverse {
    font-size: 13px;
  }

  .cart-drawer__footer > .v-stack .text-subdued {
    font-size: 12px;
    line-height: 1.5;
  }

  /* Trust badges (UpCart trust badges module) */
  .cart-drawer__footer .aao-cart-trust {
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    opacity: 0.55;
  }

  .cart-drawer__footer .aao-cart-trust svg {
    height: 20px;
    width: auto;
  }

  /* Checkout button stays the loudest element in the drawer. */
  .cart-drawer__footer .button-group {
    width: 100%;
  }

  .cart-drawer__footer .button-group .button {
    padding-block: 0.85rem;
    font-size: var(--text-base);
  }

  /* The theme's "button transition" feature inverts a solid button while it is hovered: the solid
     gradient layer collapses to zero width and the text/border take the button background colour,
     which reads as an outline button. Every time the drawer re-renders over AJAX (quick-adding a
     "Perfect match" upsell removes that card and shortens the drawer) the footer slides up under a
     stationary cursor, so the freshly inserted checkout button paints straight into that inverted
     state and the primary CTA looks unstyled until the pointer moves.

     The markup is identical on every render path (`button.button.w-full[name="checkout"]`), so the
     fix is to pin the fill by stable structural selector for every state instead of relying on a
     class modifier. Hover still gives feedback, via opacity rather than by dropping the fill. */
  .cart-drawer__footer .button-group button[name='checkout'],
  .cart-drawer__footer .button-group button[name='checkout']:hover,
  .cart-drawer__footer .button-group button[name='checkout']:focus-visible {
    color: rgb(var(--button-text-color));
    border-color: rgb(var(--button-background));
    background-image: linear-gradient(rgb(var(--button-background)), rgb(var(--button-background)));
    background-size: 101% 101%;
    background-position: center;
  }

  .cart-drawer__footer .button-group button[name='checkout']:not([disabled]):hover {
    opacity: 0.85;
  }
</style>

<script>
  (() => {
    if (customElements.get('aao-rewards-bar')) return;

    customElements.define(
      'aao-rewards-bar',
      class AaoRewardsBar extends HTMLElement {
        connectedCallback() {
          this.update();

          const target = this.querySelector('free-shipping-bar');
          if (!target) return;

          this.observer = new MutationObserver(() => this.update());
          this.observer.observe(target, { attributes: true, attributeFilter: ['total-price', 'threshold'] });
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }

        update() {
          const target = this.querySelector('free-shipping-bar');
          let progress = parseFloat(this.style.getPropertyValue('--aao-rewards-progress')) || 0;

          if (target) {
            const threshold = parseFloat(target.getAttribute('threshold'));
            const totalPrice = parseFloat(target.getAttribute('total-price'));

            if (threshold > 0 && !Number.isNaN(totalPrice)) {
              progress = Math.max(0, Math.min(100, (totalPrice / threshold) * 100));
              this.style.setProperty('--aao-rewards-progress', `${progress}%`);
            }
          }

          this.dataset.complete = progress >= 100 ? 'true' : 'false';
        }
      }
    );
  })();
</script>

<script>
  (() => {
    /* Inline add-to-cart for the drawer upsells.

       Single-variant upsells keep the theme's own product-form submit, untouched. Multi-variant ones would
       normally open the quick buy modal; here the button expands into size pills inside the card instead, and
       picking a size submits the hidden product-form rendered above, so the add and the drawer refresh run
       through the theme's ProductForm exactly like any other quick add.

       The drawer is replaced wholesale every time the cart changes, so everything below is delegated from
       `document` and nothing is bound per node. */
    if (window.__aaoUpsellsBound) return;
    window.__aaoUpsellsBound = true;

    const UPSELLS = '.aao-cart-upsells';
    const CARD = '.horizontal-product-card';
    const ADD_BUTTON = '[class*="horizontal-product-card__button"]';

    const readData = (upsells) => {
      const node = upsells.querySelector('script[data-aao-upsell-data]');
      if (!node) return null;

      try {
        return JSON.parse(node.textContent);
      } catch (error) {
        return null;
      }
    };

    const handleOf = (card) => {
      const link = card.querySelector('a[href*="/products/"]');
      const match = link && link.getAttribute('href').match(/\/products\/([^/?#]+)/);
      return match ? match[1] : null;
    };

    const collapse = (card) => {
      card.querySelectorAll('.aao-upsell-sizes').forEach((node) => node.remove());
      card.querySelectorAll(ADD_BUTTON).forEach((button) => {
        button.hidden = false;
        button.setAttribute('aria-expanded', 'false');
      });
    };

    const collapseAll = (except) => {
      document.querySelectorAll(`${UPSELLS} ${CARD}`).forEach((card) => {
        if (card !== except) collapse(card);
      });
    };

    /* Newest matching size in the cart wins: the shopper most likely wants the upsell in the size they just
       picked. Nothing matches -> nothing is pre-selected, rather than guessing. */
    const preselectedTitle = (variants, cartOptionValues) => {
      const sellable = variants.filter((variant) => variant.available).map((variant) => variant.title);

      for (let i = cartOptionValues.length - 1; i >= 0; i -= 1) {
        const match = sellable.find(
          (title) => String(title).toLowerCase() === String(cartOptionValues[i]).toLowerCase()
        );

        if (match) return match;
      }

      return null;
    };

    const expand = (card, entry, cartOptionValues) => {
      collapseAll(card);

      const info = card.querySelector('.horizontal-product-card__info') || card;
      const preselected = preselectedTitle(entry.variants, cartOptionValues);
      const group = document.createElement('div');

      group.className = 'aao-upsell-sizes';
      group.setAttribute('role', 'group');
      group.setAttribute('aria-label', 'Choose a size');

      entry.variants.forEach((variant) => {
        const pill = document.createElement('button');

        pill.type = 'button';
        pill.className = 'aao-upsell-size';
        pill.textContent = variant.title;
        pill.dataset.variantId = String(variant.id);

        if (!variant.available) {
          pill.disabled = true;
          pill.setAttribute('aria-disabled', 'true');
        } else if (variant.title === preselected) {
          pill.dataset.preselected = 'true';
        }

        group.appendChild(pill);
      });

      card.querySelectorAll(ADD_BUTTON).forEach((button) => {
        button.hidden = true;
        button.setAttribute('aria-expanded', 'true');
      });

      info.appendChild(group);

      const focusTarget = group.querySelector('[data-preselected="true"]') || group.querySelector('button:not([disabled])');
      if (focusTarget) focusTarget.focus();
    };

    const addVariant = (card, variantId) => {
      const upsells = card.closest(UPSELLS);
      const handle = handleOf(card);
      const form =
        upsells && handle
          ? upsells.querySelector(`[data-aao-upsell-form="${CSS.escape(handle)}"] form`)
          : null;

      if (!form) return false;

      const input = form.querySelector('input[name="id"]');
      if (!input) return false;

      input.value = String(variantId);
      form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      return true;
    };

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const pill = target.closest('.aao-upsell-size');

        if (pill) {
          event.preventDefault();
          event.stopPropagation();

          if (pill.disabled) return;

          const card = pill.closest(CARD);
          if (card) addVariant(card, pill.dataset.variantId);
          return;
        }

        const button = target.closest(ADD_BUTTON);

        if (button && button.closest(UPSELLS)) {
          const card = button.closest(CARD);
          const upsells = button.closest(UPSELLS);
          const data = readData(upsells);
          const handle = card && handleOf(card);
          const entry = data && handle ? data.products[handle] : null;

          /* One variant: leave the theme's product-form submit alone, it already adds and refreshes. */
          if (!entry || entry.variants.length <= 1) return;

          event.preventDefault();
          event.stopPropagation();
          expand(card, entry, (data && data.cartOptionValues) || []);
          return;
        }

        if (!target.closest('.aao-upsell-sizes')) collapseAll(null);
      },
      true
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') collapseAll(null);
    });
  })();
</script>

